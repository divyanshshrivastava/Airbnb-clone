<% layout("/layouts/boilerplate") %>
<link rel="stylesheet" href="/css/add.css" />

<div class="page-wrap">
  <form class="add-listing" action="/listings" method="POST" novalidate class="needs-validation"
    enctype="multipart/form-data">

    <h2><i class="fa-solid fa-plus-circle"></i> Add a New Listing</h2>

    <div class="form-row">
      <label for="title">Title</label>
      <input id="title" name="listing[title]" type="text" placeholder="Add a Catchy Title" required />
    </div>

    <div class="form-row">
      <label for="price">Price (₹ per night)</label>
      <input id="price" name="listing[price]" type="number" min="0" placeholder="1800" required />
    </div>

    <div class="form-row">
      <label for="location">Location</label>
      <input id="location" name="listing[location]" type="text" placeholder="Enter City eg. Gwalior" required />
    </div>

    <div class="form-row">
      <label for="country">Country</label>
      <input id="country" name="listing[country]" type="text" placeholder="India" required />
    </div>

    <div class="form-row">
      <label for="image">Upload Image</label>
      <div class="file-upload-area">
        <input id="image" name="listing[image]" type="file" required />
        <div class="file-upload-hint">
          <i class="fa-solid fa-cloud-arrow-up"></i>
          <span>Choose a file or drag it here</span>
        </div>
      </div>
      <img id="image-preview" class="image-preview" alt="Preview" style="display:none" />
    </div>

    <div class="form-row full">
      <label for="description">Description</label>
      <textarea id="description" name="listing[description]" rows="5" placeholder="Add some Description" required
        style="resize: none"></textarea>
    </div>

    <div class="form-action">
      <a href="/listings" class="cancel-btn">Cancel</a>
      <button class="btn-primary" type="submit">
        <i class="fa-solid fa-paper-plane"></i> Add Listing
      </button>
    </div>
  </form>
</div>