<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit your Listing</title>
    <link rel="stylesheet" href="/css/edit.css" />
  </head>
  <body>
    <div class="edit-container">
      <h1>Edit Your Listing</h1>
      <!-- Using method override (_method=PUT) -->
      <form action="/listings/<%= cardInfo._id %>?_method=PUT" method="POST">
        <div class="form-group">
          <label for="title">Title</label>
          <input
            type="text"
            id="title"
            name="listing[title]"
            value="<%= cardInfo.title %>"
            required
          />
        </div>

        <div class="form-group">
          <label for="description">Description</label>
          <textarea
            id="description"
            name="listing[description]"
            required
            style="resize: none"
          >
<%= cardInfo.description %> </textarea
          >
        </div>

        <div class="form-group">
          <label for="image">Image (Upload new if you want to replace)</label>
          <!-- <input type="file" id="image" name="listing[image]" /> -->
        </div>

        <div class="form-group">
          <label for="price">Price (₹)</label>
          <input
            type="number"
            id="price"
            name="listing[price]"
            value="<%= cardInfo.price %>"
            required
          />
        </div>

        <div class="form-group">
          <label for="location">Location</label>
          <input
            type="text"
            id="location"
            name="listing[location]"
            value="<%= cardInfo.location %>"
            required
          />
        </div>

        <div class="form-group">
          <label for="country">Country</label>
          <input
            type="text"
            id="country"
            name="listing[country]"
            value="<%= cardInfo.country %>"
            required
          />
        </div>

        <div class="form-actions">
          <a href="/listings/<%= cardInfo._id %>" class="cancel-btn">Cancel</a>
          <button type="submit" class="save-btn">Save Changes</button>
        </div>
      </form>
    </div>

    <script src="/js/script.js"></script>
  </body>
</html>
