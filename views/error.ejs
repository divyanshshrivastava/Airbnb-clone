<% layout("/layouts/boilerplate") %>

<style>
  .error-page {
    min-height: calc(100vh - var(--sf-navbar-h) - 300px);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--sf-space-2xl) var(--sf-space-md);
  }

  .error-card {
    max-width: 480px;
    animation: sf-scale-in 0.4s var(--sf-ease) both;
  }

  .error-icon {
    font-size: 4rem;
    margin-bottom: var(--sf-space-lg);
    display: block;
  }

  .error-code {
    font-size: var(--sf-fs-4xl);
    font-weight: var(--sf-fw-black);
    background: var(--sf-gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0 0 var(--sf-space-sm);
    line-height: 1;
  }

  .error-message {
    font-size: var(--sf-fs-lg);
    font-weight: var(--sf-fw-semibold);
    color: var(--sf-text);
    margin: 0 0 var(--sf-space-sm);
  }

  .error-desc {
    font-size: var(--sf-fs-sm);
    color: var(--sf-text-muted);
    margin: 0 0 var(--sf-space-xl);
    line-height: var(--sf-lh-relaxed);
  }

  .error-home-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--sf-space-sm);
    background: var(--sf-gradient-primary);
    color: #fff;
    padding: var(--sf-space-md) var(--sf-space-xl);
    border-radius: var(--sf-radius-pill);
    font-size: var(--sf-fs-sm);
    font-weight: var(--sf-fw-bold);
    border: none;
    text-decoration: none;
    transition: transform var(--sf-duration-fast) var(--sf-ease),
                box-shadow var(--sf-duration-fast) var(--sf-ease);
  }

  .error-home-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(255,56,92,0.3);
    color: #fff;
  }
</style>

<div class="error-page">
  <div class="error-card">
    <span class="error-icon">🏠</span>
    <h1 class="error-code"><%= statusCode %></h1>
    <p class="error-message"><%= message %></p>
    <p class="error-desc">The page you're looking for doesn't exist or may have been moved. Let's get you back on track.</p>
    <a href="/listings" class="error-home-btn">
      <i class="fa-solid fa-arrow-left"></i> Back to Home
    </a>
  </div>
</div>
